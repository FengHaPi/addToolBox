<Window x:Class="AddToolBox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="addToolBox"
        Width="1180"
        Height="760"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#F6F7F9"
        FontFamily="Segoe UI"
        SourceInitialized="OnSourceInitialized"
        StateChanged="OnWindowStateChanged"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#50545B" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#EDF1F7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#E2E7EE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TitleButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#FBE8E8" />
                                <Setter Property="Foreground" Value="#C42B1C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#F5D7D7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E3E7ED" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#5B7FD6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="11"
                                      Direction="270"
                                      ShadowDepth="2"
                                      Color="#263A55"
                                      Opacity="0.08" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ToolSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToolSurface" Property="Background" Value="#F8FAFD" />
                                <Setter TargetName="ToolSurface" Property="BorderBrush" Value="#D6E1F7" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="15"
                                                          Direction="270"
                                                          ShadowDepth="2"
                                                          Color="#263A55"
                                                          Opacity="0.12" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToolSurface" Property="Background" Value="#F1F5FD" />
                                <Setter TargetName="ToolSurface" Property="BorderBrush" Value="#AFC5F2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F6F7F9"
            BorderBrush="#E2E6EC"
            BorderThickness="1"
            CornerRadius="9">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Width="28"
                            Height="28"
                            Background="#5B7FD6"
                            CornerRadius="9">
                        <Grid>
                            <Ellipse Width="12"
                                     Height="12"
                                     HorizontalAlignment="Left"
                                     Margin="6,0,0,0"
                                     Fill="#FFFFFF"
                                     Opacity="0.96" />
                            <Rectangle Width="7"
                                       Height="7"
                                       Margin="0,0,6,0"
                                       HorizontalAlignment="Right"
                                       Fill="#DCE5F8"
                                       RadiusX="2"
                                       RadiusY="2" />
                        </Grid>
                    </Border>
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="15.5"
                               FontWeight="SemiBold"
                               Foreground="#202124"
                               Text="addToolBox" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource TitleButtonStyle}"
                            AutomationProperties.Name="添加工具（视觉占位）">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE710;" />
                    </Button>
                    <Button Style="{StaticResource TitleButtonStyle}"
                            AutomationProperties.Name="设置（视觉占位）">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE713;" />
                    </Button>
                    <Button Style="{StaticResource TitleButtonStyle}"
                            AutomationProperties.Name="最小化"
                            Click="OnMinimizeClick">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="12" Text="&#xE921;" />
                    </Button>
                    <Button Style="{StaticResource TitleButtonStyle}"
                            AutomationProperties.Name="最大化或还原"
                            Click="OnMaximizeRestoreClick">
                        <TextBlock x:Name="MaximizeGlyph"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="12"
                                   Text="&#xE922;" />
                    </Button>
                    <Button Style="{StaticResource CloseButtonStyle}"
                            AutomationProperties.Name="关闭"
                            Click="OnCloseClick">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="12" Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Canvas Grid.Row="1"
                    Width="760"
                    Height="450"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Button Canvas.Left="58"
                        Canvas.Top="38"
                        Style="{StaticResource ToolButtonStyle}">
                    <Viewbox Width="32" Height="32" Stretch="Uniform" IsHitTestVisible="False">
                        <Canvas Width="32" Height="32">
                            <Border Canvas.Left="5" Canvas.Top="3"
                                    Width="22" Height="26"
                                    BorderBrush="#5B7FD6"
                                    BorderThickness="1.7"
                                    CornerRadius="4" />
                            <Rectangle Canvas.Left="9" Canvas.Top="7"
                                       Width="14" Height="5"
                                       Fill="#E9EFFB"
                                       RadiusX="1.5" RadiusY="1.5" />
                            <Ellipse Canvas.Left="9" Canvas.Top="17" Width="3" Height="3" Fill="#5B7FD6" />
                            <Ellipse Canvas.Left="14.5" Canvas.Top="17" Width="3" Height="3" Fill="#5B7FD6" />
                            <Ellipse Canvas.Left="20" Canvas.Top="17" Width="3" Height="3" Fill="#5B7FD6" />
                            <Ellipse Canvas.Left="9" Canvas.Top="23" Width="3" Height="3" Fill="#5B7FD6" />
                            <Ellipse Canvas.Left="14.5" Canvas.Top="23" Width="3" Height="3" Fill="#5B7FD6" />
                            <Ellipse Canvas.Left="20" Canvas.Top="23" Width="3" Height="3" Fill="#5B7FD6" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button Canvas.Left="502"
                        Canvas.Top="66"
                        Style="{StaticResource ToolButtonStyle}">
                    <Viewbox Width="32" Height="32" Stretch="Uniform" IsHitTestVisible="False">
                        <Canvas Width="32" Height="32">
                            <Border Canvas.Left="3" Canvas.Top="5"
                                    Width="26" Height="22"
                                    BorderBrush="#5B7FD6"
                                    BorderThickness="1.7"
                                    CornerRadius="4" />
                            <Ellipse Canvas.Left="8" Canvas.Top="10" Width="4.5" Height="4.5" Fill="#AFC5F2" />
                            <Path Data="M 6,24 L 12,17 L 16,21 L 21,15 L 27,23"
                                  Fill="Transparent"
                                  Stroke="#5B7FD6"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button Canvas.Left="318"
                        Canvas.Top="184"
                        Style="{StaticResource ToolButtonStyle}">
                    <Viewbox Width="32" Height="32" Stretch="Uniform" IsHitTestVisible="False">
                        <Canvas Width="32" Height="32">
                            <Path Data="M 7,3 L 19,3 L 26,10 L 26,29 L 7,29 Z M 19,3 L 19,10 L 26,10"
                                  Fill="Transparent"
                                  Stroke="#5B7FD6"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                            <Line X1="11" Y1="17" X2="22" Y2="17"
                                  Stroke="#5B7FD6" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="11" Y1="22" X2="22" Y2="22"
                                  Stroke="#5B7FD6" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button Canvas.Left="126"
                        Canvas.Top="334"
                        Style="{StaticResource ToolButtonStyle}">
                    <Viewbox Width="32" Height="32" Stretch="Uniform" IsHitTestVisible="False">
                        <Canvas Width="32" Height="32">
                            <Path Data="M 14,7 L 18,3 L 29,14 L 25,18 M 17,10 L 8,19 L 6,27 L 14,25 L 23,16 M 8,23 L 12,25"
                                  Fill="Transparent"
                                  Stroke="#5B7FD6"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button Canvas.Left="618"
                        Canvas.Top="306"
                        Style="{StaticResource ToolButtonStyle}">
                    <Viewbox Width="32" Height="32" Stretch="Uniform" IsHitTestVisible="False">
                        <Canvas Width="32" Height="32">
                            <Path Data="M 5,7 L 27,7 M 16,7 L 16,26 M 10,26 L 22,26"
                                  Fill="Transparent"
                                  Stroke="#5B7FD6"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Canvas>
        </Grid>
    </Border>
</Window>
