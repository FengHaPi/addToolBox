<Window x:Class="AddToolBox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="addToolBox"
        Width="1180"
        Height="760"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#E9EDF3"
        FontFamily="Segoe UI"
        SourceInitialized="OnSourceInitialized"
        Loaded="OnWindowLoaded"
        LocationChanged="OnWindowLocationChanged"
        SizeChanged="OnWindowSizeChanged"
        StateChanged="OnWindowStateChanged"
        Deactivated="OnWindowDeactivated"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#50545B" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#EDF1F7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#E2E7EE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TitleButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#FBE8E8" />
                                <Setter Property="Foreground" Value="#C42B1C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#F5D7D7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <EventSetter Event="MouseEnter" Handler="OnToolButtonMouseEnter" />
            <EventSetter Event="PreviewMouseMove" Handler="OnToolButtonMouseMove" />
            <EventSetter Event="MouseLeave" Handler="OnToolButtonMouseLeave" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnToolButtonPreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnToolButtonPreviewMouseLeftButtonUp" />
            <EventSetter Event="LostMouseCapture" Handler="OnToolButtonLostMouseCapture" />
            <EventSetter Event="ContextMenuOpening" Handler="OnToolButtonContextMenuOpening" />
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E3E7ED" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#5B7FD6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="11"
                                      Direction="270"
                                      ShadowDepth="2"
                                      Color="#263A55"
                                      Opacity="0.08" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ToolPickupVisual">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ToolPickupScaleTransform"
                                                    CenterX="32"
                                                    CenterY="32"
                                                    ScaleX="1"
                                                    ScaleY="1" />
                                    <RotateTransform x:Name="ToolWobbleTransform"
                                                     CenterX="32"
                                                     CenterY="32" />
                                    <TranslateTransform x:Name="ToolLiftTransform" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Grid>
                                <Border x:Name="ToolSurface"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="16"
                                        RenderTransformOrigin="0.5,0.5"
                                        SnapsToDevicePixels="True">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="ToolSoftBodyScaleTransform"
                                                        ScaleX="1"
                                                        ScaleY="1" />
                                    </Border.RenderTransform>
                                    <Border x:Name="PointerHighlight"
                                            CornerRadius="16"
                                            IsHitTestVisible="False"
                                            Opacity="0">
                                        <Border.Background>
                                            <RadialGradientBrush Center="0.5,0.5"
                                                                 GradientOrigin="0.5,0.5"
                                                                 RadiusX="0.78"
                                                                 RadiusY="0.78">
                                                <GradientStop Offset="0" Color="#365B7FD6" />
                                                <GradientStop Offset="0.48" Color="#145B7FD6" />
                                                <GradientStop Offset="1" Color="#005B7FD6" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Border>
                                <Grid x:Name="ToolIconVisual"
                                      RenderTransformOrigin="0.5,0.5"
                                      IsHitTestVisible="False">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="ToolIconScaleTransform"
                                                        ScaleX="1"
                                                        ScaleY="1" />
                                    </Grid.RenderTransform>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False" />
                                </Grid>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToolSurface" Property="Background" Value="#F8FAFD" />
                                <Setter TargetName="ToolSurface" Property="BorderBrush" Value="#D6E1F7" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="15"
                                                          Direction="270"
                                                          ShadowDepth="2"
                                                          Color="#263A55"
                                                          Opacity="0.12" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToolSurface" Property="Background" Value="#F1F5FD" />
                                <Setter TargetName="ToolSurface" Property="BorderBrush" Value="#AFC5F2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowSurface"
            BorderBrush="#8293A1B2"
            BorderThickness="1"
            CornerRadius="9">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Direction="270"
                              ShadowDepth="4"
                              Color="#405269"
                              Opacity="0.18" />
        </Border.Effect>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#FCFDFE" />
                <GradientStop Offset="0.3" Color="#F6F8FB" />
                <GradientStop Offset="0.7" Color="#F1F3F7" />
                <GradientStop Offset="1" Color="#E9EDF3" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Rectangle Grid.RowSpan="2"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.18,0.08"
                                         GradientOrigin="0.18,0.08"
                                         RadiusX="0.82"
                                         RadiusY="0.68">
                        <GradientStop Offset="0" Color="#78FFFFFF" />
                        <GradientStop Offset="0.52" Color="#2AFFFFFF" />
                        <GradientStop Offset="1" Color="#00FFFFFF" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle Grid.RowSpan="2"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.46,0.38"
                                         GradientOrigin="0.46,0.38"
                                         RadiusX="0.78"
                                         RadiusY="0.82">
                        <GradientStop Offset="0.52" Color="#00556678" />
                        <GradientStop Offset="1" Color="#10556678" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid Grid.Row="0"
                  MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#8AFFFFFF" />
                        <GradientStop Offset="1" Color="#24FFFFFF" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Width="28"
                            Height="28"
                            Background="#5B7FD6"
                            CornerRadius="9">
                        <Grid>
                            <Ellipse Width="12"
                                     Height="12"
                                     HorizontalAlignment="Left"
                                     Margin="6,0,0,0"
                                     Fill="#FFFFFF"
                                     Opacity="0.96" />
                            <Rectangle Width="7"
                                       Height="7"
                                       Margin="0,0,6,0"
                                       HorizontalAlignment="Right"
                                       Fill="#DCE5F8"
                                       RadiusX="2"
                                       RadiusY="2" />
                        </Grid>
                    </Border>
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="15.5"
                               FontWeight="SemiBold"
                               Foreground="#202124"
                               Text="addToolBox" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button x:Name="LayoutLockButton"
                            Style="{StaticResource TitleButtonStyle}"
                            AutomationProperties.Name="锁定布局"
                            Click="OnLayoutLockClick">
                        <TextBlock x:Name="LayoutLockGlyph"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="15"
                                   Text="&#xE785;" />
                    </Button>
                    <Button Style="{StaticResource TitleButtonStyle}"
                            AutomationProperties.Name="最小化"
                            Click="OnMinimizeClick">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="12" Text="&#xE921;" />
                    </Button>
                    <Button Style="{StaticResource TitleButtonStyle}"
                            AutomationProperties.Name="最大化或还原"
                            Click="OnMaximizeRestoreClick">
                        <TextBlock x:Name="MaximizeGlyph"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="12"
                                   Text="&#xE922;" />
                    </Button>
                    <Button Style="{StaticResource CloseButtonStyle}"
                            AutomationProperties.Name="关闭"
                            Click="OnCloseClick">
                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="12" Text="&#xE8BB;" />
                    </Button>
                </StackPanel>

                <Border Grid.ColumnSpan="2"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="#305D6B7D"
                        IsHitTestVisible="False" />
            </Grid>

            <Grid Grid.Row="1">
                <Canvas x:Name="Workspace"
                        Background="Transparent"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                <Canvas.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="布局"
                                  FontWeight="SemiBold"
                                  IsEnabled="False" />
                        <Separator />
                        <MenuItem x:Name="WorkspaceLockMenuItem"
                                  Header="锁定布局"
                                  IsCheckable="True"
                                  Click="OnLayoutLockClick" />
                        <Separator />
                        <MenuItem Header="恢复默认布局"
                                  Click="OnResetLayoutClick" />
                    </ContextMenu>
                </Canvas.ContextMenu>
                <Button x:Name="CalculatorToolButton"
                        Canvas.Left="58"
                        Canvas.Top="38"
                        Style="{StaticResource ToolButtonStyle}">
                    <Viewbox Width="32" Height="32" Stretch="Uniform" IsHitTestVisible="False">
                        <Canvas Width="32" Height="32">
                            <Border Canvas.Left="5" Canvas.Top="3"
                                    Width="22" Height="26"
                                    BorderBrush="#5B7FD6"
                                    BorderThickness="1.7"
                                    CornerRadius="4" />
                            <Rectangle Canvas.Left="9" Canvas.Top="7"
                                       Width="14" Height="5"
                                       Fill="#E9EFFB"
                                       RadiusX="1.5" RadiusY="1.5" />
                            <Ellipse Canvas.Left="9" Canvas.Top="17" Width="3" Height="3" Fill="#5B7FD6" />
                            <Ellipse Canvas.Left="14.5" Canvas.Top="17" Width="3" Height="3" Fill="#5B7FD6" />
                            <Ellipse Canvas.Left="20" Canvas.Top="17" Width="3" Height="3" Fill="#5B7FD6" />
                            <Ellipse Canvas.Left="9" Canvas.Top="23" Width="3" Height="3" Fill="#5B7FD6" />
                            <Ellipse Canvas.Left="14.5" Canvas.Top="23" Width="3" Height="3" Fill="#5B7FD6" />
                            <Ellipse Canvas.Left="20" Canvas.Top="23" Width="3" Height="3" Fill="#5B7FD6" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button x:Name="ImageToolButton"
                        Canvas.Left="502"
                        Canvas.Top="66"
                        Style="{StaticResource ToolButtonStyle}">
                    <Viewbox Width="32" Height="32" Stretch="Uniform" IsHitTestVisible="False">
                        <Canvas Width="32" Height="32">
                            <Border Canvas.Left="3" Canvas.Top="5"
                                    Width="26" Height="22"
                                    BorderBrush="#5B7FD6"
                                    BorderThickness="1.7"
                                    CornerRadius="4" />
                            <Ellipse Canvas.Left="8" Canvas.Top="10" Width="4.5" Height="4.5" Fill="#AFC5F2" />
                            <Path Data="M 6,24 L 12,17 L 16,21 L 21,15 L 27,23"
                                  Fill="Transparent"
                                  Stroke="#5B7FD6"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button x:Name="FileToolButton"
                        Canvas.Left="318"
                        Canvas.Top="184"
                        Style="{StaticResource ToolButtonStyle}">
                    <Viewbox Width="32" Height="32" Stretch="Uniform" IsHitTestVisible="False">
                        <Canvas Width="32" Height="32">
                            <Path Data="M 7,3 L 19,3 L 26,10 L 26,29 L 7,29 Z M 19,3 L 19,10 L 26,10"
                                  Fill="Transparent"
                                  Stroke="#5B7FD6"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                            <Line X1="11" Y1="17" X2="22" Y2="17"
                                  Stroke="#5B7FD6" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="11" Y1="22" X2="22" Y2="22"
                                  Stroke="#5B7FD6" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button x:Name="ColorToolButton"
                        Canvas.Left="126"
                        Canvas.Top="334"
                        Style="{StaticResource ToolButtonStyle}">
                    <Viewbox Width="32" Height="32" Stretch="Uniform" IsHitTestVisible="False">
                        <Canvas Width="32" Height="32">
                            <Path Data="M 14,7 L 18,3 L 29,14 L 25,18 M 17,10 L 8,19 L 6,27 L 14,25 L 23,16 M 8,23 L 12,25"
                                  Fill="Transparent"
                                  Stroke="#5B7FD6"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button x:Name="TextToolButton"
                        Canvas.Left="618"
                        Canvas.Top="306"
                        Style="{StaticResource ToolButtonStyle}">
                    <Viewbox Width="32" Height="32" Stretch="Uniform" IsHitTestVisible="False">
                        <Canvas Width="32" Height="32">
                            <Path Data="M 5,7 L 27,7 M 16,7 L 16,26 M 10,26 L 22,26"
                                  Fill="Transparent"
                                  Stroke="#5B7FD6"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>
                </Canvas>

                <Border x:Name="LeftBoundaryHighlight"
                        Width="20"
                        Height="148"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        CornerRadius="0,10,10,0"
                        IsHitTestVisible="False"
                        Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform />
                    </Border.RenderTransform>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#D478A0DE" />
                            <GradientStop Offset="0.42" Color="#709DB9E8" />
                            <GradientStop Offset="1" Color="#009AB4E2" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#00FFFFFF" />
                            <GradientStop Offset="0.16" Color="#55FFFFFF" />
                            <GradientStop Offset="0.34" Color="#D6FFFFFF" />
                            <GradientStop Offset="0.5" Color="#FFFFFFFF" />
                            <GradientStop Offset="0.66" Color="#D6FFFFFF" />
                            <GradientStop Offset="0.84" Color="#55FFFFFF" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>
                <Border x:Name="TopBoundaryHighlight"
                        Width="148"
                        Height="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        CornerRadius="0,0,10,10"
                        IsHitTestVisible="False"
                        Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform />
                    </Border.RenderTransform>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#D478A0DE" />
                            <GradientStop Offset="0.42" Color="#709DB9E8" />
                            <GradientStop Offset="1" Color="#009AB4E2" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#00FFFFFF" />
                            <GradientStop Offset="0.16" Color="#55FFFFFF" />
                            <GradientStop Offset="0.34" Color="#D6FFFFFF" />
                            <GradientStop Offset="0.5" Color="#FFFFFFFF" />
                            <GradientStop Offset="0.66" Color="#D6FFFFFF" />
                            <GradientStop Offset="0.84" Color="#55FFFFFF" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>
                <Border x:Name="RightBoundaryHighlight"
                        Width="20"
                        Height="148"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        CornerRadius="10,0,0,10"
                        IsHitTestVisible="False"
                        Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform />
                    </Border.RenderTransform>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                            <GradientStop Offset="0" Color="#D478A0DE" />
                            <GradientStop Offset="0.42" Color="#709DB9E8" />
                            <GradientStop Offset="1" Color="#009AB4E2" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#00FFFFFF" />
                            <GradientStop Offset="0.16" Color="#55FFFFFF" />
                            <GradientStop Offset="0.34" Color="#D6FFFFFF" />
                            <GradientStop Offset="0.5" Color="#FFFFFFFF" />
                            <GradientStop Offset="0.66" Color="#D6FFFFFF" />
                            <GradientStop Offset="0.84" Color="#55FFFFFF" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>
                <Border x:Name="BottomBoundaryHighlight"
                        Width="148"
                        Height="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        CornerRadius="10,10,0,0"
                        IsHitTestVisible="False"
                        Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform />
                    </Border.RenderTransform>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Offset="0" Color="#D478A0DE" />
                            <GradientStop Offset="0.42" Color="#709DB9E8" />
                            <GradientStop Offset="1" Color="#009AB4E2" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#00FFFFFF" />
                            <GradientStop Offset="0.16" Color="#55FFFFFF" />
                            <GradientStop Offset="0.34" Color="#D6FFFFFF" />
                            <GradientStop Offset="0.5" Color="#FFFFFFFF" />
                            <GradientStop Offset="0.66" Color="#D6FFFFFF" />
                            <GradientStop Offset="0.84" Color="#55FFFFFF" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>
            </Grid>

            <Border x:Name="WindowInnerOutline"
                    Grid.RowSpan="2"
                    Margin="1"
                    BorderBrush="#A0FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8"
                    IsHitTestVisible="False" />
            <Border x:Name="WindowEdgeShade"
                    Grid.RowSpan="2"
                    Margin="1"
                    BorderBrush="#505B6778"
                    BorderThickness="0,0,1,1"
                    CornerRadius="8"
                    IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>
